{
    "name": "shetabit/transform-request",
    "type": "library",
    "description": "Transform laravel requests",
    "keywords": [
        "shetabit",
        "transform laravel requests",
        "modify laravel request key names",
        "laravel request transformer",
        "request transformer"
    ],
    "homepage": "https://github.com/shetabit/transform-request",
    "license": "MIT",
    "authors": [
        {
            "name": "Mahdi Khanzadi",
            "email": "khanzadimahdi@gmail.com",
            "homepage": "https://github.com/khanzadimahdi",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "shetabit/transformer": "^2.0.1|^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "orchestra/testbench": "^10.0|^11.0",
        "phpcsstandards/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Shetabit\\TransformRequest\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Shetabit\\TransformRequest\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text",
        "check-style": "phpcs",
        "fix-style": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=1G",
        "rector": "rector process --dry-run",
        "ci": [
            "@check-style",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the test suite.",
        "test-coverage": "Run the test suite and report code coverage.",
        "check-style": "Check the coding style of src and tests.",
        "fix-style": "Fix the coding style of src and tests where possible.",
        "analyse": "Run static analysis on src and tests.",
        "rector": "Show the refactorings Rector would apply.",
        "ci": "Run every check the CI pipeline runs."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shetabit\\TransformRequest\\Provider\\ServiceProvider"
            ],
            "aliases": {
                "RequestTransformer": "Shetabit\\TransformRequest\\Facade\\Transform"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
